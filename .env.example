# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Phase 2: AI chatbot and summarizer
# "gateway" (default: Vercel AI Gateway, needs a card on file in Vercel to unlock free credits) or "deepseek"
AI_PROVIDER=
# Gateway: on Vercel, OIDC auth is automatic; locally `vercel env pull` gives VERCEL_OIDC_TOKEN (or set a key)
AI_GATEWAY_API_KEY=
# Gateway model string (default anthropic/claude-haiku-5.5)
AI_MODEL=
# DeepSeek backup: the group's own key; model default deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Class budget per 30 days in USD (default 4; class mode at 80%), daily request cap (default 3000), kill switch
AI_BUDGET_USD=
AI_DAILY_CAP=
AI_DISABLED=

# Phase 2: rate limiting and class-mode budget (Upstash Redis via Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Phase 4: set to 1 for the final launch build so leftover TODO: placeholders fail the build
CONTENT_STRICT=
