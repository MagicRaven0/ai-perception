# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Phase 2: AI chatbot and summarizer (Vercel AI Gateway; on Vercel, OIDC auth can replace the key)
AI_GATEWAY_API_KEY=
# Model string routed through the Gateway, chosen at Phase 2 kickoff
AI_MODEL=
# Optional backup provider
DEEPSEEK_API_KEY=

# Phase 2: rate limiting and class-mode budget (Upstash Redis via Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Phase 4: set to 1 for the final launch build so leftover TODO: placeholders fail the build
CONTENT_STRICT=
