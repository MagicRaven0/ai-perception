{
  "name": "ai-perception",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check-content": "tsx scripts/check-content.ts",
    "prebuild": "tsx scripts/check-content.ts",
    "verify": "npm run typecheck && npm run lint && npm run check-content",
    "test:e2e": "playwright test",
    "format": "prettier --write \"app/**/*.tsx\" \"components/**/*.tsx\" \"lib/**/*.ts\" \"content/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "gen-ai": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/gen-ai.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.87",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@ai-sdk/react": "4.0.177",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "ai": "7.0.173",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
